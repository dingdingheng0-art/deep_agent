# ---- 复制为 .env 并填入真实值；.env 已被 .gitignore 排除，切勿提交 ----

# Kimi (Moonshot) Claude 兼容 API
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=

# Tavily 搜索
TAVILY_API_KEY=

# LangSmith 可观测性
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# ========== 测试用例生成配置 ==========

# 测试用例 Agent 使用的模型
TESTCASE_MODEL=

# 测试用例工作空间（真实磁盘路径，子代理与主 Agent 共享）
TESTCASE_WORKSPACE_DIR=

# DeepSeek 输出上限（默认 8192）
TESTCASE_MAX_TOKENS=8192

# thinking 开关（enabled/disabled，默认 disabled）
# 注意：低 thinking 下质量无下降，且 thinking 曾吃掉大量输出配额
TESTCASE_THINKING=disabled

# 多模态大模型（用于 docling 图片解析）
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

# docling serve 地址（远程服务器）
DOCLING_BASE_URL=

# QQ 邮箱 SMTP 凭证（测试报告邮件智能体）
QQ_MAIL_USER=
QQ_MAIL_PASSWORD=

# 千问多模态（图片类需求解析，OpenAI 兼容接口）
DEEPSEEK_API_KEY=
